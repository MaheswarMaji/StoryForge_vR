index 0000000..360882d
--- /dev/null
+++ b/backend/services/studio_request.py
@@ -0,0 +1,442 @@
+"""Builds the request.json handed to the Studio still-image worker (batch.py).
+
+Pure functions only: no database, network or subprocess imports, so the cast logic can be unit-tested
+and dry-run (backend/tools/studio_dry_run.py) without touching the GPU.
+
+What Studio needs per scene is (a) WHO is on screen and (b) WHAT happens. Both used to be lossy:
+
+* the character guide was parsed line-by-line with one regex, so a guide written as "Name" + bullet
+  attributes produced fake characters called "Clothing", "Skin", "Style";
+* a scene whose text did not literally contain a character's (Latin) name was given EVERY character,
+  which is how a lone child meditating became a group portrait;
+* the prompt was the bare scene text, with nothing tying it to the characters in frame.
+
+Rules now:
+* attribute / style lines never become characters (style lines are folded into the style string);
+* cast comes from what the scene DEPICTS (visual / video_prompt). Narration is only used when the
+  visual names nobody. If nobody is named at all the scene gets the protagonist alone - never everyone;
+* every scene prompt states who is in frame, with each character's identity tag, and that nobody else is;
+* if the guide has text but no character can be extracted, we raise CastError instead of silently
+  sending one blob that merges every character into every image.
+"""
+import re
+import unicodedata
+from dataclasses import dataclass, field
+
+MAX_SCENES = 24
+MAX_CHARACTERS = 6      # the worker is given at most this many named characters
+MAX_CAST = 4            # and at most this many appear in one scene
+MAX_DESC = 1500
+MAX_PROMPT = 3000
+STYLE_BUDGET = 600
+
+
+class CastError(ValueError):
+    """The character guide could not be turned into separate characters."""
+
+
+# ---------------------------------------------------------------- text helpers
+_DEVA = re.compile(r'[\u0900-\u097F]')
+_BULLET = re.compile(r'^\s*(?:[-•*▪●◦‣]+|\d+[.)])\s*')
+_KV = re.compile(r'^\s*([^:：\n]{1,60}?)\s*[:：]\s*(.*)$')
+_KV_DASH = re.compile(r'^\s*(.{1,60}?)\s[—–-]\s+(.+)$')
+_SENTENCE_PUNCT = re.compile(r'[.।!?;,]')
+_SEPARATOR = re.compile(r'^\s*[-=*_~#]{3,}\s*$')
+
+
+def _clean_line(line):
+    line = line.replace('**', '').replace('__', '').replace('`', '')
+    line = re.sub(r'^\s*#+\s*', '', line)
+    return line.rstrip()
+
+
+def _norm(text):
+    """Comparison form: NFC, no joiners/nukta, lowercase, doubled vowels collapsed (Suneeti == Suniti)."""
+    text = unicodedata.normalize('NFC', text or '')
+    text = text.replace('\u200c', '').replace('\u200d', '').replace('\u093c', '')
+    return text.lower().replace('ee', 'i').replace('oo', 'u').replace('aa', 'a')
+
+
+_AGE_PIECE = re.compile(r'(?i)^\W*\d|\b(?:age|aged|years?|yrs?|old)\b|वर्ष|साल|आयु|उम्र')
+
+
+def _is_num_piece(piece):
+    """True for parenthetical age notes such as "(5 years)" or "(5 वर्ष)" - never an alias."""
+    return bool(_AGE_PIECE.search(piece))
+
+
+# ---------------------------------------------------------------- guide vocabulary
+def _words(*items):
+    return {_norm(i) for i in items}
+
+
+STYLE_ONLY_KEYS = _words(
+    'style', 'art style', 'visual style', 'medium', 'palette', 'color palette', 'colour palette', 'lighting',
+    'light', 'background', 'backgrounds', 'setting', 'settings', 'environment', 'camera', 'aspect ratio',
+    'aspect', 'format', 'rules', 'rule', 'avoid', 'negative', 'negative prompt', 'do not', 'never',
+    'शैली', 'स्टाइल', 'कला शैली', 'आर्ट स्टाइल', 'रंग पैलेट', 'कलर पैलेट', 'प्रकाश', 'लाइटिंग', 'पृष्ठभूमि',
+    'बैकग्राउंड', 'वातावरण', 'कैमरा', 'नियम', 'ध्यान रखें')
+ATTRIBUTE_KEYS = _words(
+    'age', 'आयु', 'उम्र', 'clothing', 'clothes', 'dress', 'attire', 'outfit', 'costume', 'वेशभूषा', 'वस्त्र',
+    'पोशाक', 'पहनावा', 'appearance', 'look', 'looks', 'features', 'हुलिया', 'रूप', 'दिखावट', 'hair', 'बाल',
+    'skin', 'skin tone', 'complexion', 'त्वचा', 'रंग', 'eyes', 'आँखें', 'आंखें', 'face', 'चेहरा', 'body',
+    'build', 'कद', 'ornaments', 'jewellery', 'jewelry', 'accessories', 'आभूषण', 'गहने', 'props', 'हथियार',
+    'expression', 'personality', 'temperament', 'स्वभाव', 'role', 'भूमिका', 'relation', 'रिश्ता', 'voice',
+    'आवाज़', 'note', 'notes', 'नोट', 'colors', 'colours', 'signature', 'identity', 'pose', 'marks',
+    'distinguishing marks', 'gender', 'लिंग', 'height', 'ऊंचाई')
+
+_GUIDE_TITLE = re.compile(r'(?i)(गाइड|guide|bible|consistency|संगति|रेफ़रेंस|रेफरेंस|reference|sheet)')
+_CHAR_SECTION = re.compile(
+    r'(?i)^(?:मुख्य\s+|main\s+)?(?:पात्र(?:\s+(?:सूची|परिचय|विवरण))?|कैरेक्टर(?:s)?|characters?|cast)\s*[:：]?\s*$')
+_STYLE_SECTION = re.compile(
+    r'(?i)^.{0,40}(?:style|स्टाइल|शैली|palette|पैलेट|rules|नियम|background|पृष्ठभूमि|lighting|लाइटिंग).{0,20}$')
+_STOP_TOKENS = _words('the', 'a', 'an', 'of', 'and', 'sri', 'shri', 'shree', 'श्री', 'जी')
+# Generic roles never identify one person on their own ("the queen" may be either queen): they are only
+# ever matched as part of the full name ("Queen Suruchi"), not as a separate alias.
+_ROLE_TOKENS = _words('king', 'queen', 'prince', 'princess', 'sage', 'lord', 'saint', 'rishi', 'muni', 'raja',
+                      'rani', 'maharaj', 'devi', 'god', 'goddess', 'mother', 'father', 'boy', 'girl', 'child',
+                      'राजा', 'रानी', 'राजकुमार', 'ऋषि', 'मुनि', 'देवी', 'भगवान', 'माता', 'पिता', 'बालक', 'बच्चा')
+
+
+@dataclass
+class Character:
+    key: str
+    name: str
+    description: str
+    aliases: list = field(default_factory=list)
+    mentions: int = 0
+    _rx: object = None
+    _skels: set = field(default_factory=set)
+
+    @property
+    def tag(self):
+        """Short identity phrase repeated in every scene this character appears in."""
+        segments = [s.strip() for s in re.split(r'[;।\n]|(?<=[.!?])\s', self.description) if s.strip()]
+        out = ''
+        for seg in segments[:3]:
+            out = f'{out}; {seg}' if out else seg
+            if len(out) >= 60:
+                break
+        return out[:160]
+
+
+# ---------------------------------------------------------------- character guide parsing
+def _split_kv(line):
+    m = _KV.match(line)
+    if m:
+        return m.group(1).strip(' *'), m.group(2).strip()
+    m = _KV_DASH.match(line)
+    if m:
+        return m.group(1).strip(' *'), m.group(2).strip()
+    return None
+
+
+def parse_guide(anchor):
+    """Split a free-text character/style guide into ([(name, description)], style_notes)."""
+    lines = [_clean_line(l) for l in (anchor or '').splitlines()]
+    lines = [l for l in lines if l.strip() and not _SEPARATOR.match(l)]
+    chars, style, current, mode = [], [], None, 'chars'
+
+    def next_line(i):
+        return lines[i + 1] if i + 1 < len(lines) else ''
+
+    for i, raw in enumerate(lines):
+        bullet = bool(_BULLET.match(raw))
+        line = _BULLET.sub('', raw).strip()
+        if not line:
+            continue
+        kv = _split_kv(line)
+        key, rest = (kv if kv else (None, None))
+        nkey = _norm(key) if key else None
+
+        # section headers ("Characters", "Style block") and the guide's own title
+        if (not kv or not rest) and len(line) <= 50:
+            bare = line.rstrip(':：').strip()
+            if _CHAR_SECTION.match(bare):
+                mode, current = 'chars', None
+                continue
+            if _STYLE_SECTION.match(bare) and not _SENTENCE_PUNCT.search(bare):
+                mode, current = 'style', None
+                continue
+            if not kv and _GUIDE_TITLE.search(bare):
+                continue
+
+        if mode == 'style':
+            looks_like_character = (kv and rest and len(key.split()) <= 5
+                                    and nkey not in STYLE_ONLY_KEYS and nkey not in ATTRIBUTE_KEYS)
+            if not looks_like_character:
+                style.append(f'{key}: {rest}' if kv and rest else line)
+                continue
+            mode = 'chars'       # a "Name: description" line ends the style block
+
+        if kv and nkey in STYLE_ONLY_KEYS:
+            style.append(f'{key}: {rest}' if rest else key)
+            continue
+        if kv and nkey in ATTRIBUTE_KEYS:
+            if current is not None:
+                if rest:
+                    current['parts'].append(f'{key}: {rest}')
+            elif rest:
+                style.append(f'{key}: {rest}')
+            continue
+
+        new_char = None
+        if kv and len(key.split()) <= 5 and (rest or _is_heading_context(lines, i)):
+            new_char = (key, rest)
+        elif not kv and _is_heading(line, next_line(i)):
+            new_char = (line, '')
+        if new_char:
+            current = {'name': new_char[0].strip(' *'), 'parts': [new_char[1]] if new_char[1] else []}
+            chars.append(current)
+        elif current is not None:
+            current['parts'].append(line)     # wrapped description line
+        # else: preamble text before the first character; ignored
+
+    out = []
+    for c in chars:
+        desc = re.sub(r'\s+', ' ', '; '.join(p for p in c['parts'] if p)).strip()
+        if desc:
+            out.append((c['name'], desc[:MAX_DESC]))
+    return out, ' '.join(style)
+
+
+def _is_heading_context(lines, i):
+    nxt = lines[i + 1] if i + 1 < len(lines) else ''
+    return bool(_BULLET.match(nxt)) or bool(nxt.startswith((' ', '\t')))
+
+
+def _is_heading(line, nxt):
+    if len(line) > 40 or len(line.split()) > 5 or _SENTENCE_PUNCT.search(line) or not nxt:
+        return False
+    if _BULLET.match(nxt) or nxt.startswith((' ', '\t')):
+        return True
+    kv = _split_kv(_BULLET.sub('', nxt).strip())
+    return bool(kv and _norm(kv[0]) in ATTRIBUTE_KEYS)
+
+
+# ---------------------------------------------------------------- characters, aliases, matching
+def _slug(name, taken, n):
+    latin = re.sub(r'\([^)]*\)', ' ', name)
+    latin = ' '.join(re.findall(r'[A-Za-z][A-Za-z0-9\'-]*', latin)) or ' '.join(re.findall(r'[A-Za-z][A-Za-z0-9\'-]*', name))
+    base = re.sub(r'[^a-z0-9]+', '_', latin.lower()).strip('_')[:24] or f'char{n}'
+    key, i = base, 2
+    while key in taken:
+        key, i = f'{base}_{i}', i + 1
+    return key
+
+
+def _display_name(name):
+    """"Dhruv (5 वर्ष)" -> "Dhruv": age notes in brackets are description, not part of the name."""
+    def drop(m):
+        return '' if _is_num_piece(m.group(1)) else m.group(0)
+    return re.sub(r'\s+', ' ', re.sub(r'\s*\(([^)]*)\)', drop, name)).strip() or name
+
+
+def _alias_candidates(name, extra=()):
+    pieces = re.split(r'[()/,|]|\s[—–-]\s|\bor\b|\baka\b', name)
+    out = []                                            # (alias, min_len)
+    for piece in list(pieces) + list(extra):
+        piece = piece.strip(' *')
+        if not piece or _is_num_piece(piece):      # skips "(5 years)" / "(5 वर्ष)"
+            continue
+        out.append((piece, 2))                      # a whole name may be short: "Om"
+        tokens = piece.split()
+        if len(tokens) > 1:
+            out.extend((t, 3) for t in tokens if _norm(t) not in _STOP_TOKENS | _ROLE_TOKENS)
+    seen, uniq = set(), []
+    for a, min_len in out:
+        n = _norm(a)
+        if len(n) >= min_len and n not in _STOP_TOKENS and n not in seen:
+            seen.add(n)
+            uniq.append(a)
+    return uniq
+
+
+# Cross-script matching: "ध्रुव" and "Dhruv" both reduce to the consonant skeleton "drv"; "सुनीति"/"Suniti" to "snt".
+_DEVA_CONSONANT = {
+    'क': 'k', 'ख': 'k', 'ग': 'g', 'घ': 'g', 'ङ': 'n', 'च': 'c', 'छ': 'c', 'ज': 'j', 'झ': 'j', 'ञ': 'n',
+    'ट': 't', 'ठ': 't', 'ड': 'd', 'ढ': 'd', 'ण': 'n', 'त': 't', 'थ': 't', 'द': 'd', 'ध': 'd', 'न': 'n',
+    'प': 'p', 'फ': 'p', 'ब': 'b', 'भ': 'b', 'म': 'm', 'य': 'y', 'र': 'r', 'ल': 'l', 'व': 'v', 'श': 's',
+    'ष': 's', 'स': 's', 'ळ': 'l', 'ऋ': 'r', 'ृ': 'r', 'क़': 'k', 'ख़': 'k', 'ग़': 'g', 'ज़': 'j', 'फ़': 'p',
+    'ड़': 'd', 'ढ़': 'd'}
+_WORD = re.compile(r'[A-Za-z\u0900-\u097F]+')
+_SKEL_CACHE = {}
+
+
+def _skeleton(word):
+    """Coarse consonant skeleton of a Latin or Devanagari word (>= 3 letters to be useful, else '')."""
+    if word in _SKEL_CACHE:
+        return _SKEL_CACHE[word]
+    w = unicodedata.normalize('NFC', word).lower()
+    letters = []
+    for ch in w:
+        if ch in _DEVA_CONSONANT:
+            letters.append(_DEVA_CONSONANT[ch])
+        elif 'a' <= ch <= 'z' and ch not in 'aeiouh':
+            letters.append({'w': 'v', 'q': 'k', 'x': 's'}.get(ch, ch))
+    out = ''.join(c for i, c in enumerate(letters) if i == 0 or c != letters[i - 1])
+    _SKEL_CACHE[word] = out if len(out) >= 3 else ''
+    return _SKEL_CACHE[word]
+
+
+def _skeletons(aliases):
+    out = set()
+    for a in aliases:
+        for tok in _WORD.findall(a):
+            if _norm(tok) in _STOP_TOKENS | _ROLE_TOKENS:
+                continue
+            sk = _skeleton(tok)
+            if sk:
+                out.add(sk)
+    return out
+
+
+def _compile(aliases):
+    alts = []
+    for a in aliases:
+        n = _norm(a).strip()
+        if not n:
+            continue
+        if _DEVA.search(n):
+            alts.append(re.escape(n))
+        else:
+            stem = n[:-1] if n.endswith('a') and len(n) > 3 else n
+            alts.append(r'(?<![a-z0-9])' + r'\s+'.join(re.escape(p) for p in stem.split()) + r'a?(?![a-z0-9])')
+    return re.compile('|'.join(alts)) if alts else None
+
+
+def _first_pos(char, text_norm):
+    """Earliest position where the character is named in text (exact alias or cross-script skeleton), else -1."""
+    best = -1
+    if char._rx is not None:
+        m = char._rx.search(text_norm)
+        best = m.start() if m else -1
+    if char._skels:
+        for m in _WORD.finditer(text_norm):
+            if 0 <= best <= m.start():
+                break
+            if _skeleton(m.group()) in char._skels:
+                best = m.start()
+                break
+    return best
+
+
+def characters_from(story):
+    """-> (characters, style_notes, warnings). Prefers story['characters'], else parses the guide."""
+    warnings, rows, style_notes = [], [], ''
+    extras = {}
+    for c in story.get('characters') or []:
+        if isinstance(c, dict) and (c.get('name') or '').strip() and (c.get('description') or '').strip():
+            rows.append((c['name'].strip(), c['description'].strip()[:MAX_DESC]))
+            extras[c['name'].strip()] = [str(a) for a in (c.get('aliases') or []) if str(a).strip()]
+    if not rows:
+        sheet = story.get('character_sheet') or {}
+        anchor = (sheet.get('anchor') or sheet.get('text') or '').strip()
+        if not anchor:
+            anchor = (((story.get('script') or {}).get('character_sheet') or {}).get('anchor') or '').strip()
+        rows, style_notes = parse_guide(anchor)
+        if anchor and not rows and not style_notes and len(re.sub(r'\s', '', anchor)) >= 40:
+            raise CastError(
+                'The character guide has text but no separate characters could be read from it, and sending it as '
+                'one blob would merge every character into every image. Write each character on its own line as '
+                '"Name: description" (or "Name" followed by bullet lines such as "- Clothing: ..."), then retry.')
+
+    chars, taken = [], set()
+    for n, (name, desc) in enumerate(rows, 1):
+        key = _slug(name, taken, n)
+        taken.add(key)
+        chars.append(Character(key=key, name=_display_name(name), description=desc,
+                               aliases=_alias_candidates(name, extras.get(name, ()))))
+
+    # an alias shared by several characters ("queen", "king") identifies nobody: drop it everywhere
+    count = {}
+    for c in chars:
+        for a in {_norm(a) for a in c.aliases}:
+            count[a] = count.get(a, 0) + 1
+    for c in chars:
+        c.aliases = [a for a in c.aliases if count[_norm(a)] == 1]
+        c._rx = _compile(c.aliases)
+    sk_count = {}
+    for c in chars:
+        c._skels = _skeletons(c.aliases)
+        for sk in c._skels:
+            sk_count[sk] = sk_count.get(sk, 0) + 1
+    for c in chars:                                   # "Suniti" vs "Sunita" would collide: exact spelling only
+        c._skels = {sk for sk in c._skels if sk_count[sk] == 1}
+    return chars, style_notes.strip(), warnings
+
+
+# ---------------------------------------------------------------- scenes
+def _depicted_text(chunk):
+    visual, video = str(chunk.get('visual') or ''), str(chunk.get('video_prompt') or '')
+    return _norm(visual if visual == video or not video else f'{visual} {video}')
+
+
+def _story_text(chunk):
+    return _norm(f"{chunk.get('voiceover') or ''} {chunk.get('source_label') or ''}")
+
+
+def _order(chars, text):
+    hits = [(p, c) for c in chars for p in [_first_pos(c, text)] if p >= 0]
+    return [c for _, c in sorted(hits, key=lambda t: t[0])]
+
+
+def _scene_prompt(chunk, cast):
+    core = (chunk.get('video_prompt') or chunk.get('visual') or chunk.get('voiceover') or '').strip()
+    core = re.sub(r'\s+', ' ', core)[:2100]
+    if not cast:
+        return core[:MAX_PROMPT]
+    who = '; '.join(f'{c.name} ({c.tag})' for c in cast)
+    frame = f'In frame, and only these people: {who}. Draw each exactly as described; add no other characters.'
+    return f'{core} {frame}'[:MAX_PROMPT]
+
+
+def build(story, channel, project_id):
+    """-> (request, report). `request` goes to the worker; `report` is for humans (logs, dry-run, job QC)."""
+    chars, style_notes, warnings = characters_from(story)
+    chunks = ((story.get('script') or {}).get('chunks') or [])[:MAX_SCENES]
+
+    scene_texts = [(_depicted_text(c), _story_text(c)) for c in chunks]
+    for ch in chars:                                         # protagonist = most mentioned overall
+        ch.mentions = sum(1 for d, s in scene_texts if _first_pos(ch, d) >= 0 or _first_pos(ch, s) >= 0)
+    if len(chars) > MAX_CHARACTERS:
+        keep = sorted(chars, key=lambda c: -c.mentions)[:MAX_CHARACTERS]
+        dropped = [c.name for c in chars if c not in keep]
+        chars = [c for c in chars if c in keep]
+        warnings.append(f'Only {MAX_CHARACTERS} characters can be sent; left out (least used): {", ".join(dropped)}')
+    protagonist = max(chars, key=lambda c: c.mentions) if chars else None
+
+    scenes, scene_report, weak = [], [], {}
+    for i, chunk in enumerate(chunks):
+        depicted, told = scene_texts[i]
+        cast, basis = _order(chars, depicted), 'visual'
+        if not cast:
+            cast, basis = _order(chars, told), 'narration'
+        if not cast and protagonist:
+            cast, basis = [protagonist], 'protagonist-fallback'
+        cast = cast[:MAX_CAST]
+        sid = f'S{i + 1:03d}'
+        scenes.append({'id': sid, 'cast': [c.key for c in cast], 'image_prompt': _scene_prompt(chunk, cast)})
+        scene_report.append({'id': sid, 'cast': [c.name for c in cast], 'basis': basis})
+        if basis != 'visual' and chars:
+            weak.setdefault(basis, []).append(sid)
+
+    for basis, ids in weak.items():
+        warnings.append(f'{", ".join(ids)}: no character is named in the visual text, so the cast came from {basis}. '
+                        'Name who is on screen in that scene\'s visual to control it.')
+
+    style = (channel.get('style_prefix') or story.get('visual_style') or 'Indian miniature painting style').strip()
+    if style_notes:
+        style = f'{style}. {style_notes[:max(0, STYLE_BUDGET - len(style) - 40)]}'.rstrip('. ')
+    if '9:16' not in style:
+        style += ', vertical 9:16'
+    if 'no text' not in style.lower():
+        style += ', no text or captions in the image'
+
+    request = {'project_id': project_id, 'style': style[:STYLE_BUDGET],
+               'characters': {c.key: c.description for c in chars}, 'scenes': scenes}
+    report = {'characters': [{'key': c.key, 'name': c.name, 'aliases': c.aliases, 'scenes_mentioning': c.mentions}
+                             for c in chars],
+              'protagonist': protagonist.name if protagonist else None,
+              'style_notes': style_notes, 'scenes': scene_report, 'warnings': warnings}
+    return request, report
