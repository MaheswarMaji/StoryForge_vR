+#!/usr/bin/env python3
+"""Show exactly what StoryForge would send to the Studio worker for a story - without running the GPU.
+
+    python tools/studio_dry_run.py --story-id <id>            # reads the story from MongoDB
+    python tools/studio_dry_run.py --json story.json          # or from an exported story document
+    add --prompts to print every scene's full image prompt, --write request.json to save the worker request.
+
+Read the "basis" column: `visual` = the character is named in the scene's visual text (good);
+`narration` / `protagonist-fallback` = nobody was named on screen, so name them in that scene's visual.
+"""
+import argparse
+import asyncio
+import json
+import sys
+from pathlib import Path
+
+BACKEND = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(BACKEND))
+
+from services import studio_request  # noqa: E402  (pure module: no DB needed for --json)
+
+
+async def _load_from_db(story_id):
+    from dotenv import load_dotenv
+    load_dotenv(BACKEND / '.env')
+    from db import db
+    story = await db.stories.find_one({'_id': story_id})
+    if not story:
+        sys.exit(f'story {story_id} not found')
+    channel = await db.channels.find_one({'_id': story.get('channel_id')}) or {}
+    return story, channel
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    src = ap.add_mutually_exclusive_group(required=True)
+    src.add_argument('--story-id')
+    src.add_argument('--json', help='story document exported as JSON (may be {"story": ..., "channel": ...})')
+    ap.add_argument('--prompts', action='store_true')
+    ap.add_argument('--write', metavar='FILE')
+    args = ap.parse_args()
+
+    if args.json:
+        data = json.loads(Path(args.json).read_text(encoding='utf-8'))
+        story, channel = data.get('story', data), data.get('channel', {})
+    else:
+        story, channel = asyncio.run(_load_from_db(args.story_id))
+
+    try:
+        request, report = studio_request.build(story, channel, 'dry_run')
+    except studio_request.CastError as error:
+        sys.exit(f'CHARACTERS_UNPARSED: {error}')
+
+    print('CHARACTERS (as Studio will see them)')
+    for c in report['characters']:
+        star = '  <- protagonist' if c['name'] == report['protagonist'] else ''
+        print(f"  {c['key']:<18} {c['name']:<22} in {c['scenes_mentioning']} scene(s){star}")
+        print(f"  {'':<18} matches on: {', '.join(c['aliases']) or '-'}")
+        print(f"  {'':<18} {request['characters'][c['key']][:110]}")
+    print(f"\nSTYLE  {request['style']}\n\nSCENES")
+    for s, scene in zip(report['scenes'], request['scenes']):
+        print(f"  {s['id']}  {', '.join(s['cast']) or '(nobody)':<48} [{s['basis']}]")
+        if args.prompts:
+            print(f"        {scene['image_prompt']}\n")
+    if report['warnings']:
+        print('\nWARNINGS')
+        for w in report['warnings']:
+            print(f'  - {w}')
+    if args.write:
+        Path(args.write).write_text(json.dumps(request, ensure_ascii=False, indent=2), encoding='utf-8')
+        print(f'\nwritten: {args.write}')
+
+
+if __name__ == '__main__':
+    main()
