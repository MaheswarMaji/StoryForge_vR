+"""Cast / prompt building for the Studio worker. Pure logic: no GPU, DB or network."""
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from services import studio_request as sr  # noqa: E402
+
+GUIDE_LINES = """पात्र एवं दृश्य संगति गाइड
+Dhruv (5 वर्ष): 5-year-old boy, simple saffron cloth, no crown, no jewellery, bare chest
+Suniti: Dhruv's mother, cream cotton saree, gentle eyes, no jewellery
+Queen Suruchi: crimson silk saree with gold border, crown, heavy jewellery
+King Uttanapada: yellow dhoti, tall gold crown, grey moustache
+Sage Narada: orange robes, white beard, veena, matted hair
+Vishnu: Lord Vishnu, blue skin, four arms, conch, discus, yellow pitambara"""
+
+GUIDE_HEADINGS = """पात्र एवं दृश्य संगति गाइड
+Characters
+Dhruv
+- Age: 5 years
+- Clothing: simple saffron cloth, no crown, no jewellery
+Suniti
+- Age: adult
+- Clothing: cream cotton saree
+Narada
+- Clothing: orange robes, white beard, veena
+Vishnu
+- Skin: blue, four arms, conch and discus
+Style block
+- Style: Indian miniature painting, warm palette
+- Soft rim light, no modern objects"""
+
+CHUNKS = [
+    {'visual': 'A single bright star over a dark night sky, temple silhouette below.',
+     'voiceover': 'ध्रुव तारा आज भी चमकता है।', 'source_label': 'हुक'},
+    {'visual': "Royal court. Queen Suruchi pushes little Dhruv off King Uttanapada's lap; the king looks away.",
+     'voiceover': 'सुरुचि ने कहा...', 'source_label': 'अपमान'},
+    {'visual': 'Dhruv weeps in a small hut while Suniti holds him.', 'voiceover': '', 'source_label': 'सांत्वना'},
+    {'visual': 'Sage Narada, veena in hand, meets Dhruv on a forest path.', 'voiceover': '', 'source_label': ''},
+    {'visual': 'A small boy sits alone under a banyan tree, eyes closed, meditating.',
+     'voiceover': 'वह अकेला तपस्या करता रहा।', 'source_label': 'तपस्या'},
+    {'visual': 'Lord Vishnu appears in golden light before the meditating boy.', 'voiceover': 'Dhruv opened his eyes.',
+     'source_label': ''},
+]
+
+
+def story(anchor, chunks=CHUNKS, **extra):
+    return {'character_sheet': {'anchor': anchor}, 'script': {'chunks': [dict(c, video_prompt=c['visual']) for c in chunks]},
+            **extra}
+
+
+def build(anchor, **kw):
+    return sr.build(story(anchor, **kw), {'style_prefix': 'Indian miniature painting'}, 'proj')
+
+
+def cast_of(request, i):
+    return request['scenes'][i]['cast']
+
+
+@pytest.mark.parametrize('anchor', [GUIDE_LINES, GUIDE_HEADINGS])
+def test_no_scene_gets_everyone(anchor):
+    request, _ = build(anchor)
+    everyone = set(request['characters'])
+    assert len(everyone) >= 4
+    assert all(set(s['cast']) != everyone for s in request['scenes'])
+
+
+def test_lone_child_scene_is_only_the_child():
+    request, report = build(GUIDE_LINES)
+    assert cast_of(request, 4) == ['dhruv']          # "a small boy sits alone" names nobody -> protagonist alone
+    assert report['scenes'][4]['basis'] == 'protagonist-fallback'
+    assert any('S005' in w for w in report['warnings'])
+
+
+def test_court_scene_has_the_three_people_in_it_and_no_one_else():
+    request, _ = build(GUIDE_LINES)
+    assert set(cast_of(request, 1)) == {'dhruv', 'queen_suruchi', 'king_uttanapada'}
+
+
+def test_narada_and_vishnu_stay_separate():
+    request, _ = build(GUIDE_LINES)
+    assert 'vishnu' not in cast_of(request, 3) and 'sage_narada' in cast_of(request, 3)
+    assert 'sage_narada' not in cast_of(request, 5) and 'vishnu' in cast_of(request, 5)
+    assert 'blue' not in request['characters']['sage_narada'] and 'veena' not in request['characters']['vishnu']
+
+
+def test_attribute_lines_are_not_characters():
+    request, report = build(GUIDE_HEADINGS)
+    assert set(request['characters']) == {'dhruv', 'suniti', 'narada', 'vishnu'}
+    assert 'saffron' in request['characters']['dhruv'] and 'no crown' in request['characters']['dhruv']
+    assert 'Indian miniature painting' in request['style'] and 'rim light' in request['style']
+    assert '9:16' in request['style']
+
+
+def test_narration_only_used_when_visual_names_nobody():
+    chunks = [{'visual': 'A quiet forest clearing at dawn.', 'voiceover': 'Narada found Dhruv there.'}]
+    request, report = build(GUIDE_LINES, chunks=chunks)
+    assert cast_of(request, 0) == ['sage_narada', 'dhruv'] or set(cast_of(request, 0)) == {'sage_narada', 'dhruv'}
+    assert report['scenes'][0]['basis'] == 'narration'
+
+
+def test_prompt_carries_scene_action_and_identity_of_everyone_in_frame():
+    request, _ = build(GUIDE_LINES)
+    prompt = request['scenes'][1]['image_prompt']
+    assert 'pushes little Dhruv' in prompt
+    assert 'Queen Suruchi (' in prompt and 'crown' in prompt
+    assert 'only these people' in prompt and 'Suniti' not in prompt.split('In frame')[1]
+    assert len(prompt) <= sr.MAX_PROMPT
+
+
+def test_child_identity_tag_says_five_year_old_no_crown():
+    request, _ = build(GUIDE_LINES)
+    assert '5-year-old' in request['scenes'][4]['image_prompt'] and 'no crown' in request['scenes'][4]['image_prompt']
+
+
+def test_devanagari_names_match():
+    guide = "ध्रुव: पाँच साल का बालक, सादे भगवा वस्त्र\nसुनीति: ध्रुव की माँ, क्रीम रंग की साड़ी\nसुरुचि: रानी, लाल रेशमी साड़ी, मुकुट"
+    chunks = [{'visual': 'सुरुचि ध्रुव को गोद से उतार देती है।'}, {'visual': 'सुनीति ध्रुव को गले लगाती है।'}]
+    request, _ = build(guide, chunks=chunks)
+    assert set(cast_of(request, 0)) == {'char1', 'char3'}
+    assert set(cast_of(request, 1)) == {'char1', 'char2'}
+
+
+def test_latin_alias_does_not_match_inside_words():
+    guide = "Om: a small boy in a yellow shirt with round glasses\nRavi: a tall man in a blue kurta"
+    chunks = [{'visual': 'The boy walks home from school.'}, {'visual': 'Om looks up at Ravi.'}]
+    request, _ = build(guide, chunks=chunks)
+    assert cast_of(request, 1) == ['om', 'ravi']
+
+
+def test_variant_spelling_and_possessive():
+    chunks = [{'visual': "Dhruva's mother Suneeti smiles."}]
+    request, _ = build(GUIDE_LINES, chunks=chunks)
+    assert set(cast_of(request, 0)) == {'dhruv', 'suniti'}
+
+
+def test_explicit_characters_field_wins_and_accepts_aliases():
+    st = {'characters': [{'name': 'Raju', 'description': 'a boy in a red shirt', 'aliases': ['the boy']},
+                         {'name': 'Meera', 'description': 'a girl in a green frock'}],
+          'script': {'chunks': [{'visual': 'The boy waves.'}]}}
+    request, _ = sr.build(st, {}, 'p')
+    assert cast_of(request, 0) == ['raju']
+
+
+def test_unparseable_guide_fails_loudly_instead_of_sending_a_blob():
+    prose = ("A five year old boy in saffron cloth and his mother in a cream saree walk through the palace "
+             "gardens while a queen in red watches from the balcony with cold eyes.")
+    with pytest.raises(sr.CastError):
+        build(prose)
+
+
+def test_empty_guide_is_fine():
+    request, report = build('')
+    assert request['characters'] == {} and all(s['cast'] == [] for s in request['scenes'])
+
+
+def test_more_than_limit_keeps_most_used():
+    guide = '\n'.join(f'Person{n}: a villager number {n} with a distinct blue turban' for n in range(9))
+    chunks = [{'visual': f'Person{n} stands there.'} for n in range(9)] + [{'visual': 'Person8 and Person7 talk.'}]
+    request, report = build(guide, chunks=chunks)
+    assert len(request['characters']) == sr.MAX_CHARACTERS
+    assert 'person8' in request['characters'] and 'person7' in request['characters']
+    assert any('left out' in w for w in report['warnings'])
+
+
+def test_request_is_deterministic():
+    a, _ = build(GUIDE_LINES)
+    b, _ = build(GUIDE_LINES)
+    assert a == b
+
+
+HINDI_SCENES = [
+    {'visual': 'सुरुचि रानी ध्रुव को राजा उत्तानपाद की गोद से उतार देती है।'},
+    {'visual': 'नारद मुनि वीणा लिए वन में ध्रुव से मिलते हैं।'},
+    {'visual': 'भगवान विष्णु प्रकट होते हैं।'},
+    {'visual': 'सुनीति ध्रुव को गले लगाती है।'},
+]
+
+
+def test_latin_guide_matches_hindi_scene_text():
+    request, report = build(GUIDE_LINES, chunks=HINDI_SCENES)
+    assert set(cast_of(request, 0)) == {'dhruv', 'queen_suruchi', 'king_uttanapada'}
+    assert set(cast_of(request, 1)) == {'sage_narada', 'dhruv'}
+    assert cast_of(request, 2) == ['vishnu']
+    assert set(cast_of(request, 3)) == {'suniti', 'dhruv'}
+    assert all(s['basis'] == 'visual' for s in report['scenes'])
+
+
+def test_hindi_guide_matches_latin_scene_text():
+    guide = ("ध्रुव: पाँच साल का बालक, सादे भगवा वस्त्र, कोई मुकुट नहीं\n"
+             "नारद: मुनि, नारंगी वस्त्र, सफ़ेद दाढ़ी, वीणा\n"
+             "विष्णु: नीली त्वचा, चार भुजाएँ, शंख और चक्र")
+    chunks = [{'visual': 'Narada meets Dhruv in the forest.'}, {'visual': 'Vishnu appears before Dhruv.'}]
+    request, _ = build(guide, chunks=chunks)
+    assert len(set(cast_of(request, 0))) == 2 and len(set(cast_of(request, 1))) == 2
+    assert set(cast_of(request, 0)) != set(cast_of(request, 1))
+
+
+def test_near_identical_names_do_not_cross_match():
+    guide = "Suniti: Dhruv's mother, cream saree\nSunita: a neighbour, green saree\nDhruv: a boy in saffron cloth"
+    chunks = [{'visual': 'Suniti hugs Dhruv.'}, {'visual': 'Sunita waves.'}]
+    request, _ = build(guide, chunks=chunks)
+    assert set(cast_of(request, 0)) == {'suniti', 'dhruv'}
+    assert cast_of(request, 1) == ['sunita']
+
+
+def test_age_note_is_not_part_of_the_displayed_name():
+    request, report = build(GUIDE_LINES)
+    assert report['characters'][0]['name'] == 'Dhruv'
+    assert 'वर्ष' not in request['scenes'][4]['image_prompt']
+
+
+def test_generic_role_words_do_not_identify_a_person():
+    chunks = [{'visual': 'The queen watches from the balcony while the king sleeps.'}]
+    request, report = build(GUIDE_LINES, chunks=chunks)
+    assert cast_of(request, 0) == ['dhruv'] and report['scenes'][0]['basis'] == 'protagonist-fallback'
+    chunks = [{'visual': 'Queen Suruchi watches from the balcony.'}]
+    request, _ = build(GUIDE_LINES, chunks=chunks)
+    assert cast_of(request, 0) == ['queen_suruchi']
