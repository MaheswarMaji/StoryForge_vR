# --- required ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="storyforge"

# --- Google sign-in ---
# Create an OAuth 2.0 "Web application" client in Google Cloud Console and add
# http://localhost:3000 and your public https URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=""
# true = every /api route needs a Google login (set this in production, after GOOGLE_CLIENT_ID works)
AUTH_REQUIRED=false
# The ONLY admin accounts (comma-separated Gmail addresses)
ADMIN_EMAILS=""
# Who may sign in. Empty = any Google account. Admins are always allowed.
ALLOWED_EMAILS=""
# Set to true when the site is served over https (cross-site cookies)
COOKIE_SECURE=false   # set to true behind https

# --- optional: where uploaded PDFs are kept (default: <repo>/storage) ---
# STORAGE_DIR=/path/to/storage

# --- Studio (local image worker on this server; defaults shown) ---
# STUDIO_ROOT=/home/siddhesh/studio
# STUDIO_PYTHON=/home/siddhesh/studio/runtime/envs/studio-v007/bin/python
# STUDIO_BATCH_SCRIPT=/home/siddhesh/studio/tools/studio_story_batch_v011/batch.py

# --- AI providers: set whichever you use (can also be entered later on the Settings page) ---
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# OPENAI_TEXT_MODEL="gpt-5.4"
STABILITY_API_KEY=""
HF_TOKEN=""
FAL_KEY=""
REPLICATE_API_TOKEN=""
PEXELS_API_KEY=""
